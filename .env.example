# =============================================================================
# 1. 공통 실행 환경
# =============================================================================
# 서버 실행 모드입니다. 로컬 개발은 development, 배포 환경은 production을 사용합니다.
ENV=development

# =============================================================================
# 2. DB 및 데이터 인프라
# =============================================================================
# -----------------------------------------------------------------------------
# 2-1. Supabase 인증 및 사용자 데이터
# -----------------------------------------------------------------------------
# Supabase 프로젝트 URL입니다. 예: https://your-project.supabase.co
SUPABASE_URL=
# 클라이언트 공개 용도의 Supabase publishable/anon 키입니다. RLS 정책을 우회할 수 없습니다.
# 백엔드에서는 권한이 필요한 작업에 사용하지 않습니다.
SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 Supabase secret/service-role 키입니다. API 로그와 users/login_history
# 동기화에 사용하며, RLS를 우회할 수 있으므로 브라우저, 로그, Postman 공유 환경
# 파일에 절대 넣지 않습니다.
SUPABASE_SECRET_KEY=
# Supabase API 로그 INSERT가 기다릴 최대 시간(초)입니다. 실패해도 원래 API 응답은 유지합니다.
API_LOG_TIMEOUT_SECONDS=2
# Access Token 검증과 로그인 테이블 동기화가 기다릴 최대 시간(초)입니다.
AUTH_TIMEOUT_SECONDS=2

# -----------------------------------------------------------------------------
# 2-2. Redis DB 및 캐시
# -----------------------------------------------------------------------------
# Redis는 Tutor 요청 제한과 재사용 가능한 데이터를 보관하는 인메모리 DB/캐시입니다.
# 연결 URL입니다. 예: redis://localhost:6379/0
REDIS_URL=

# =============================================================================
# 3. 사전 및 번역 외부 서비스
# =============================================================================
# 영어 사전 API의 기본 URL입니다. 예: https://api.dictionaryapi.dev/api/v2/entries/en
DICTIONARY_API_URL=
# DeepL API 인증 키입니다. 서버에서만 사용하며 커밋하지 않습니다.
DEEPL_API_KEY=
# DeepL API 기본 URL입니다. Free 플랜은 https://api-free.deepl.com,
# Pro 플랜은 https://api.deepl.com 을 사용합니다.
DEEPL_API_BASE_URL=

# =============================================================================
# 4. LLM(AI) - Video Tutor
# =============================================================================
# 사용할 LLM provider입니다.
# stub: 외부 API 없이 결정적인 테스트 응답 사용
# gemini / groq: 지정한 provider 우선, 실패 시 다른 provider와 stub으로 fallback
# auto: Gemini 우선, Groq, stub 순서로 fallback
LLM_PROVIDER=stub

# -----------------------------------------------------------------------------
# 4-1. Google Gemini
# -----------------------------------------------------------------------------
# Google AI Studio 등에서 발급한 Gemini API 키입니다. 서버에서만 사용하며 커밋하지 않습니다.
GEMINI_API_KEY=
# 사용할 Gemini 모델 이름입니다.
GEMINI_MODEL=gemini-3.6-flash
# Gemini API 응답을 기다리는 최대 시간(초)입니다.
GEMINI_TIMEOUT_SECONDS=20
# Tutor 답변의 최대 생성 토큰 수입니다. 화면 답변은 짧게 제한하되 JSON을 끝까지
# 완성할 여유를 위해 기본값은 512입니다.
TUTOR_MAX_OUTPUT_TOKENS=512
# 서버가 자체적으로 추적할 일일/분당 토큰 상한입니다. 0은 해당 로컬 제한을 끕니다.
# 실제 provider의 요금제 한도와 일치하지 않을 수 있으므로 운영 환경에서 별도로 조정합니다.
GEMINI_DAILY_TOKEN_LIMIT=0
GEMINI_MINUTE_TOKEN_LIMIT=0

# -----------------------------------------------------------------------------
# 4-2. Groq
# -----------------------------------------------------------------------------
# Groq Console에서 발급한 API 키입니다. 서버에서만 사용하며 커밋하지 않습니다.
GROQ_API_KEY=
# 사용할 Groq 호환 모델 식별자입니다.
GROQ_MODEL=openai/gpt-oss-20b
# Groq API 응답을 기다리는 최대 시간(초)입니다.
GROQ_TIMEOUT_SECONDS=20
# 서버가 자체적으로 추적할 일일/분당 토큰 상한입니다. 0은 해당 로컬 제한을 끕니다.
# 아래 값은 무료 플랜을 위한 안전 마진이며, 유료 요금제에서는 실제 한도에 맞춰 조정합니다.
GROQ_DAILY_TOKEN_LIMIT=180000
GROQ_MINUTE_TOKEN_LIMIT=7000

# -----------------------------------------------------------------------------
# 4-3. Tutor 호출 제어
# -----------------------------------------------------------------------------
# 선제 질문을 다시 표시하기까지 필요한 영상 재생 시점의 간격(초)입니다.
TUTOR_PROACTIVE_COOLDOWN_SECONDS=180
# 영상 하나에서 표시할 선제 질문의 최대 횟수입니다. 0이면 선제 질문을 표시하지 않습니다.
TUTOR_PROACTIVE_MAX_QUESTIONS_PER_VIDEO=3
# 사용자별 Tutor 질문의 분당 허용 횟수입니다. 로그인 전에는 anonymous 사용자로 집계합니다.
# 0은 호출 횟수 제한을 끕니다.
TUTOR_REQUESTS_PER_MINUTE=30
