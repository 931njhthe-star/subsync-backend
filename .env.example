ENV=development

# stub | gemini | groq | auto
LLM_PROVIDER=stub

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
# 0이면 로컬 quota guard를 끄고 provider의 실제 429만 따른다.
GEMINI_DAILY_TOKEN_LIMIT=0
GEMINI_MINUTE_TOKEN_LIMIT=0

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=20
# 무료 플랜 안전 마진. 유료 plan은 실제 한도에 맞춰 변경하거나 0으로 설정한다.
GROQ_DAILY_TOKEN_LIMIT=180000
GROQ_MINUTE_TOKEN_LIMIT=7000

# 선제 질문을 다시 표시하기 전까지 필요한 영상 재생 시점 간격(초)
TUTOR_PROACTIVE_COOLDOWN_SECONDS=45

SUPABASE_URL=
SUPABASE_KEY=
REDIS_URL=
JWT_SECRET_KEY=
