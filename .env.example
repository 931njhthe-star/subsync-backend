ENV=development

# stub | gemini | groq | auto
LLM_PROVIDER=stub

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
# 0이면 로컬 quota guard를 끄고 provider의 실제 429만 따른다.
GEMINI_DAILY_TOKEN_LIMIT=0
GEMINI_MINUTE_TOKEN_LIMIT=0

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=20
# 무료 플랜 안전 마진. 유료 plan은 실제 한도에 맞춰 변경하거나 0으로 설정한다.
GROQ_DAILY_TOKEN_LIMIT=180000
GROQ_MINUTE_TOKEN_LIMIT=7000

SUPABASE_URL=
# Supabase publishable/anon key. HS256일 때 Auth API 검증에 사용한다.
SUPABASE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
# 비워 두면 {SUPABASE_URL}/auth/v1을 사용한다.
SUPABASE_JWT_ISSUER=
# auto | jwks | auth_api
SUPABASE_AUTH_VERIFICATION_MODE=auto
SUPABASE_JWKS_CACHE_SECONDS=600
SUPABASE_AUTH_TIMEOUT_SECONDS=5
REDIS_URL=
