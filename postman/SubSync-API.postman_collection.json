{
  "info": {
    "_postman_id": "8d45be32-7f4a-4f0e-a8d7-2ad5f8a0c901",
    "name": "SubSync Backend API",
    "description": {
      "content": "현재 구현된 SubSync FastAPI 라우트에 대한 회귀 테스트 모음입니다.\n\n- 기본 URL은 {{base_url}} 변수로 관리합니다.\n- 현재 tutor/ask는 인증 dependency가 연결되지 않았으므로 토큰 없이 실행됩니다.\n- Supabase Auth 연동 후에는 환경 변수의 access_token을 입력하면 요청에 Bearer 토큰이 자동으로 추가됩니다.",
      "type": "text/markdown"
    },
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Supabase Auth를 연결한 뒤 access_token이 있으면 보호 API에 자동으로 전달한다.",
          "const token = pm.environment.get('access_token');",
          "if (token && token.trim()) {",
          "    pm.request.headers.upsert({",
          "        key: 'Authorization',",
          "        value: `Bearer ${token.trim()}`",
          "    });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "video_id",
      "value": "arj7oStGLkU",
      "type": "string"
    },
    {
      "key": "timestamp",
      "value": "156.4",
      "type": "string"
    },
    {
      "key": "conversation_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "message_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health",
            "description": "서버가 요청을 받을 수 있는지 확인합니다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('상태 코드는 200이다', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('응답은 JSON이다', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('status가 ok이다', function () {",
                  "    pm.expect(body.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "02. Video Tutor",
      "item": [
        {
          "name": "Ask tutor - 개인화 답변",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"video_id\": \"{{video_id}}\",\n  \"timestamp\": {{timestamp}},\n  \"user_message\": \"be honest with는 어떤 뜻인가요?\",\n  \"recent_subtitles\": [\n    {\n      \"time\": 150.0,\n      \"en\": \"I know it sounds crazy.\",\n      \"ko\": \"말도 안 되게 들리겠지만요.\"\n    },\n    {\n      \"time\": 156.4,\n      \"en\": \"I want to be honest with you.\",\n      \"ko\": \"솔직하게 말씀드리고 싶어요.\"\n    }\n  ],\n  \"learner_signals\": {\n    \"saved_words\": [\n      { \"word\": \"honest\" }\n    ],\n    \"quiz_accuracy\": 0.72,\n    \"average_response_time_ms\": 7500,\n    \"recent_quiz_accuracy\": 0.8,\n    \"recent_response_time_ms\": 6200,\n    \"quiz_attempts\": 6\n  },\n  \"conversation_history\": [],\n  \"focus_word\": \"honest\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/tutor/ask",
            "description": "영상 자막 문맥과 학습자 신호를 이용해 Tutor 답변을 생성합니다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('상태 코드는 200이다', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('응답은 JSON이다', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('필수 답변 필드가 존재한다', function () {",
                  "    ['conversation_id', 'message_id', 'reply', 'suggested_questions', 'provider', 'model', 'usage', 'learner_level', 'tutor_difficulty', 'profile_confidence', 'context_subtitle_count'].forEach(function (key) {",
                  "        pm.expect(body, `필드 누락: ${key}`).to.have.property(key);",
                  "    });",
                  "});",
                  "",
                  "pm.test('답변 본문이 비어 있지 않다', function () {",
                  "    pm.expect(body.reply).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test('후속 질문은 최대 3개다', function () {",
                  "    pm.expect(body.suggested_questions).to.be.an('array');",
                  "    pm.expect(body.suggested_questions.length).to.be.at.most(3);",
                  "});",
                  "",
                  "pm.test('provider가 허용된 값이다', function () {",
                  "    pm.expect(['gemini', 'groq', 'stub']).to.include(body.provider);",
                  "});",
                  "",
                  "pm.test('사용량 값이 0 이상이다', function () {",
                  "    pm.expect(body.usage.input_tokens).to.be.at.least(0);",
                  "    pm.expect(body.usage.output_tokens).to.be.at.least(0);",
                  "    pm.expect(body.usage.total_tokens).to.be.at.least(0);",
                  "});",
                  "",
                  "pm.test('학습자 수준과 Tutor 난이도가 허용된 값이다', function () {",
                  "    pm.expect(['A1', 'A2', 'B1', 'B2', 'C1']).to.include(body.learner_level);",
                  "    pm.expect(['foundational', 'guided', 'conversational', 'nuanced', 'challenge']).to.include(body.tutor_difficulty);",
                  "});",
                  "",
                  "pm.test('신뢰도는 0과 1 사이이다', function () {",
                  "    pm.expect(body.profile_confidence).to.be.within(0, 1);",
                  "});",
                  "",
                  "pm.environment.set('conversation_id', body.conversation_id);",
                  "pm.environment.set('message_id', body.message_id);",
                  "pm.environment.set('last_reply', body.reply);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Ask tutor - 대화 이력 포함",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"video_id\": \"{{video_id}}\",\n  \"timestamp\": {{timestamp}},\n  \"user_message\": \"예문을 하나 더 보여주세요.\",\n  \"recent_subtitles\": [\n    {\n      \"time\": 156.4,\n      \"en\": \"I want to be honest with you.\",\n      \"ko\": \"솔직하게 말씀드리고 싶어요.\"\n    }\n  ],\n  \"learner_signals\": {\n    \"quiz_accuracy\": 0.72,\n    \"average_response_time_ms\": 7500,\n    \"quiz_attempts\": 6\n  },\n  \"conversation_history\": [\n    {\n      \"role\": \"user\",\n      \"message\": \"be honest with는 어떤 뜻인가요?\"\n    },\n    {\n      \"role\": \"tutor\",\n      \"message\": \"상대방에게 솔직하게 말할 때 사용하는 표현이에요.\"\n    }\n  ],\n  \"focus_word\": \"honest\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/tutor/ask",
            "description": "이전 대화 이력을 포함한 Tutor 요청이 정상 처리되는지 확인합니다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('상태 코드는 200이다', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('대화 이력이 있어도 답변을 반환한다', function () {",
                  "    pm.expect(body.reply).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.context_subtitle_count).to.be.at.least(1);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "03. Validation",
      "item": [
        {
          "name": "Tutor ask - 음수 timestamp 거부",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"video_id\": \"{{video_id}}\",\n  \"timestamp\": -1,\n  \"user_message\": \"테스트\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/tutor/ask",
            "description": "Pydantic의 timestamp >= 0 검증을 확인합니다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('상태 코드는 422이다', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('validation detail이 존재한다', function () {",
                  "    pm.expect(body.detail).to.be.an('array').and.not.empty;",
                  "});",
                  "",
                  "pm.test('timestamp 오류를 반환한다', function () {",
                  "    const locations = body.detail.map(function (item) { return item.loc.join('.'); });",
                  "    pm.expect(locations.some(function (location) { return location.includes('timestamp'); })).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Tutor ask - 필수 필드 누락 거부",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"timestamp\": 10,\n  \"user_message\": \"video_id가 없습니다.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/tutor/ask",
            "description": "필수 필드 video_id 누락 시 요청이 거부되는지 확인합니다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('상태 코드는 422이다', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('video_id 필수 오류를 반환한다', function () {",
                  "    const locations = body.detail.map(function (item) { return item.loc.join('.'); });",
                  "    pm.expect(locations.some(function (location) { return location.includes('video_id'); })).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}
